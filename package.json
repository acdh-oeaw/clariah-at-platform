{
	"$schema": "https://www.schemastore.org/package",
	"name": "@clariah/website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "bun run --bun next analyze",
		"build": "bun run --bun next build",
		"dev": "bun run --bun next dev",
		"dev:prepare": "sh ./scripts/dev/prepare.sh",
		"dev:services:down": "sh ./scripts/dev/services.sh stop",
		"dev:services:setup": "sh ./scripts/dev/setup.sh",
		"dev:services:up": "sh ./scripts/dev/services.sh start",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:openapi": "bun ./scripts/openapi/generate.ts",
		"i18n:convert-messages": "bun ./scripts/i18n/convert-messages.ts",
		"i18n:extract-messages": "bun ./scripts/i18n/extract-messages.ts",
		"lint:check": "bun run --parallel lint:code:check lint:styles:check",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "bun run --parallel lint:code:fix lint:styles:fix",
		"lint:i18n:check": "eloqnt lint",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"prepare": "bun run dev:prepare types:prepare generate:openapi",
		"search:api-keys:generate": "bun ./scripts/search/generate-search-api-keys.ts",
		"search:collections:create": "bun ./scripts/search/create-collections.ts",
		"search:collections:reset": "bun ./scripts/search/reset-collections.ts",
		"start": "bun run --bun next start",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"types:check": "tsc --noEmit",
		"types:prepare": "ENV_VALIDATION=\"disabled\" bun run --bun next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@sindresorhus/slugify": "^4.0.1",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-heading": "^3.33.0",
		"@tiptap/extension-table": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"@tiptap/static-renderer": "^3.33.0",
		"better-result": "^3.0.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.70.0",
		"next": "^16.4.5",
		"next-intl": "^4.14.9",
		"react": "^19.3.1",
		"react-aria": "^3.53.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"typesense": "^3.2.0",
		"valibot": "^1.5.0",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.38.2",
		"@eloqnt/cli": "^0.6.33",
		"@playwright/test": "1.64.1",
		"@tailwindcss/turbopack": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-regexp": "^3.3.3",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"openapi-typescript": "^7.13.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2006",
		"po-parser": "^2.2.0",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.0.0",
		"tailwindcss": "^4.3.5",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"stylelint": {
		"extends": "./configs/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.4.4",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.4.4",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
