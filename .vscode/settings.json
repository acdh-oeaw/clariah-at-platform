{
	"css.validate": false,
	"editor.codeActionsOnSave": {
		"source.fixAll": "explicit"
	},
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.formatOnSave": true,
	"editor.inlayHints.enabled": "offUnlessPressed",
	"editor.linkedEditing": true,
	"editor.quickSuggestions": {
		"strings": true
	},
	"editor.rulers": [120],
	"editor.stickyScroll.enabled": true,
	"emmet.showExpandedAbbreviation": "never",
	"eslint.enable": false,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"js/ts.experimental.useTsgo": true,
	"js/ts.inlayHints.parameterNames.enabled": "all",
	"js/ts.preferences.autoImportFileExcludePatterns": [
		"lucide-react",
		"next/router.d.ts",
		"next/dist/client/router.d.ts"
	],
	"js/ts.preferences.importModuleSpecifier": "non-relative",
	"js/ts.preferences.preferTypeOnlyAutoImports": true,
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"oxc.enable": true,
	"prettier.enable": false,
	"stylelint.enable": true,
	"stylelint.validate": ["css", "tailwindcss"],
	"tailwindCSS.classFunctions": ["cn", "styles"],
	"tailwindCSS.validate": true,
	"terminal.integrated.enablePersistentSessions": false,
	"workbench.editor.customLabels.patterns": {
		"**/app/**/default.tsx": "${dirname(1)}/${dirname} - default.tsx",
		"**/app/**/error.tsx": "${dirname(1)}/${dirname} - error.tsx",
		"**/app/**/forbidden.tsx": "${dirname(1)}/${dirname} - forbidden.tsx",
		"**/app/**/layout.tsx": "${dirname(1)}/${dirname} - layout.tsx",
		"**/app/**/loading.tsx": "${dirname(1)}/${dirname} - loading.tsx",
		"**/app/**/not-found.tsx": "${dirname(1)}/${dirname} - not-found.tsx",
		"**/app/**/page.tsx": "${dirname(1)}/${dirname} - page.tsx",
		"**/app/**/route.ts": "${dirname(1)}/${dirname} - route.ts",
		"**/app/**/template.tsx": "${dirname(1)}/${dirname} - template.tsx",
		"**/app/**/unauthorized.tsx": "${dirname(1)}/${dirname} - unauthorized.tsx"
	},
	"workbench.editor.labelFormat": "medium",
	"workbench.tree.enableStickyScroll": true,
	"[markdown]": {
		"editor.wordWrap": "on"
	},
	"i18n-ally.localesPaths": ["messages", "lib/i18n"]
}
